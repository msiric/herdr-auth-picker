#!/bin/sh
# Run auth-picker with a Python new enough for it (3.11+), whatever `python3`
# happens to be. Many Macs still have Apple's Python 3.9 as `python3`.
#
# Tries, in order: $AUTH_PICKER_PYTHON (an absolute path), python3.14 down to
# python3.11, then python3 (only if it is 3.11 or newer), on PATH and in
# Homebrew's usual places. Runs it in isolated mode (-I), so the environment
# cannot substitute modules.
set -u

# herdr runs `event` on every agent status change, for every agent. Drop the
# ones that are not Claude or Codex here, before paying for a Python start.
if [ "${1:-}" = event ]; then
    case "${HERDR_PLUGIN_EVENT_JSON:-}" in
        *'"agent":"claude"'* | *'"agent":"codex"'*) ;;
        *) exit 0 ;;
    esac
fi

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 70
main="$here/../main.py"

usable() {
    "$1" -I -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null
}

if [ -n "${AUTH_PICKER_PYTHON:-}" ]; then
    case "$AUTH_PICKER_PYTHON" in
        /*) try_path=$AUTH_PICKER_PYTHON ;;
        *) echo "auth-picker: AUTH_PICKER_PYTHON must be an absolute path" >&2; exit 2 ;;
    esac
    if [ -x "$try_path" ] && usable "$try_path"; then
        exec "$try_path" -I "$main" "$@"
    fi
    echo "auth-picker: AUTH_PICKER_PYTHON is not Python 3.11 or newer" >&2
    exit 2
fi

# A versioned name says its version, so it is used without starting it to
# check (that check costs a whole Python start). Only plain python3 is probed.
for name in python3.14 python3.13 python3.12 python3.11; do
    for candidate in $(command -v "$name" 2>/dev/null) \
        "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
        if [ -x "$candidate" ]; then
            exec "$candidate" -I "$main" "$@"
        fi
    done
done
for candidate in $(command -v python3 2>/dev/null) /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if [ -x "$candidate" ] && usable "$candidate"; then
        exec "$candidate" -I "$main" "$@"
    fi
done

echo "auth-picker: needs Python 3.11 or newer, and found none." >&2
echo "Install one (e.g. \`brew install python@3.13\`) or set AUTH_PICKER_PYTHON." >&2
exit 2
